void handleData() {
  String json = "{\"status\":\"" + lockedAIState + "\", \"temp\":" + String(features[0]) + ", \"hum\":" + String(features[1]) + ", \"water\":" + String(features[2]) + ", \"gas\":" + String(features[3]) + ", \"vib\":" + String(features[6]) + ", \"risk\":" + String(overallRisk) + "}";
  server.send(200, "application/json", json);
}

void setup() {
  Serial.begin(115200);
  Wire.begin(21, 22); 

  if(!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) Serial.println("OLED Failed");
  display.clearDisplay(); display.setTextSize(1); display.setTextColor(SSD1306_WHITE);
  display.setCursor(0, 0); display.println("RAKSHAK Booting..."); display.display();

  pinMode(TRIG_PIN, OUTPUT); pinMode(ECHO_PIN, INPUT);
  pinMode(BUZZER_PIN, OUTPUT);
  pinMode(RGB_RED, OUTPUT); pinMode(RGB_GREEN, OUTPUT); pinMode(RGB_BLUE, OUTPUT);
  pinMode(MQ2_PIN, INPUT);

  dht.begin();
  if (!mpu.begin()) Serial.println("MPU6050 Failed");

  display.clearDisplay(); display.setCursor(0, 0); display.print("Connecting to: "); display.println(ssid); display.display();
  
  WiFi.begin(ssid, password);
  int retries = 0;
  while (WiFi.status() != WL_CONNECTED && retries < 20) { delay(500); retries++; }
  
  server.on("/", handleRoot);
  server.on("/data", handleData);
  server.begin();
  delay(2000);
}

void loop() {
  server.handleClient();

  // 1. READ REAL SENSORS
  if (millis() - lastDHTRead > 3000) { 
      float t = dht.readTemperature();
      float h = dht.readHumidity();
      if (!isnan(t) && t > -10 && t < 70) currentTemp = t; 
      if (!isnan(h) && h >= 0 && h <= 100) currentHum = h;
      lastDHTRead = millis();
  }
  
  features[0] = currentTemp; 
  features[1] = currentHum; 
  
  digitalWrite(TRIG_PIN, LOW); delayMicroseconds(2);
  digitalWrite(TRIG_PIN, HIGH); delayMicroseconds(10);
  digitalWrite(TRIG_PIN, LOW);
  long duration = pulseIn(ECHO_PIN, HIGH, 30000);
  float distance = (duration * 0.0343) / 2;
  features[2] = (duration == 0 || distance > 400) ? 200.0 : distance; 
  
  features[3] = analogRead(MQ2_PIN);
  
  // True Gravity-Cancelled Vibration Calculation
  sensors_event_t a, g, temp;
  mpu.getEvent(&a, &g, &temp);
  float totalAccel = sqrt(pow(a.acceleration.x, 2) + pow(a.acceleration.y, 2) + pow(a.acceleration.z, 2));
  features[6] = abs(totalAccel - 9.81); 
  
  // DEADBAND: Ignore tiny desk bumps under 0.3g
  if (features[6] < 0.3) features[6] = 0.0;

  // Dynamic Mocker for missing hardware
  features[4] = 30.0; 
  features[5] = 0.0;  
  if (features[2] < 50.0 || features[6] > 1.2) {
      features[4] = 95.0; 
      features[5] = 80.0; 
  }

  // 3. RUN AI
  signal_t signal;
  numpy::signal_from_buffer(features, FEATURE_COUNT, &signal);
  ei_impulse_result_t result = { 0 };
  run_classifier(&signal, &result, false);

  String bestLabel = "";
  float bestValue = 0.0;
  for (size_t ix = 0; ix < EI_CLASSIFIER_LABEL_COUNT; ix++) {
      if (result.classification[ix].value > bestValue) {
          bestValue = result.classification[ix].value;
          bestLabel = result.classification[ix].label;
      }
  }

  // ==========================================
  // BRUTE-FORCE DUAL-FACTOR LOGIC 
  // ==========================================
  
  // 1. ABSOLUTE GAS SILENCER: If gas is under 2000, ignore any AI fire/smoke hallucination.
  if (features[3] < 2000.0) {
      if (bestLabel == "fire_risk" || bestLabel == "pollution") {
          bestLabel = "normal";
      }
  }

  // 2. TRUE GAS THREAT ROUTER (Only runs if gas is 2000+)
  if (features[3] >= 2000.0) {
      if (features[0] >= 38.0) {
          // Gas is high AND temperature is burning hot -> REAL FIRE
          bestLabel = "fire_risk";
      } else {
          // Gas is high BUT temperature is cool/normal -> SEVERE POLLUTION
          bestLabel = "pollution";
      }
  }

  // STRICT LANDSLIDE BLOCKER (Requires actual physical bump)
  if (bestLabel == "landslide_risk" && features[6] < 0.8) {
      bestLabel = "normal";
  }

  // STRICT FLOOD BLOCKER (Requires actual close water depth)
  if (bestLabel == "flood_risk" && features[2] > 50.0) {
      bestLabel = "normal";
  }

  // ==========================================
  // STATE LOCK / DEBOUNCE (Buzzer stutter fix)
  // ==========================================
  if (bestLabel != "normal") {
      lockedAIState = bestLabel; 
      alertLockTimer = millis(); 
  } else {
      // Must remain quiet and clear for 3 full seconds before shutting off alarm
      if (millis() - alertLockTimer > 3000) { 
          lockedAIState = "normal";
      }
  }

  lockedAIState.toUpperCase();

  // Calculate Overall Risk %
  if (lockedAIState == "NORMAL") overallRisk = 5;
  else if (lockedAIState == "POLLUTION") overallRisk = 75 + (features[3] > 3000 ? 10 : 0);
  else if (lockedAIState == "FIRE_RISK") overallRisk = 85 + (features[0] > 45.0 ? 10 : 0);
  else if (lockedAIState == "FLOOD_RISK") overallRisk = 80 + (features[2] < 30.0 ? 15 : 0);
  else if (lockedAIState == "LANDSLIDE_RISK") overallRisk = 85 + (features[6] > 2.0 ? 10 : 0);
  if (overallRisk > 100) overallRisk = 100;

  // 4. HARDWARE ALERTS
  if (lockedAIState == "NORMAL") {
    digitalWrite(BUZZER_PIN, LOW); 
    digitalWrite(RGB_GREEN, HIGH); digitalWrite(RGB_RED, LOW); digitalWrite(RGB_BLUE, LOW);
  } else if (lockedAIState == "LANDSLIDE_RISK" || lockedAIState == "FLOOD_RISK") {
    digitalWrite(BUZZER_PIN, HIGH); 
    digitalWrite(RGB_BLUE, HIGH); digitalWrite(RGB_RED, LOW); digitalWrite(RGB_GREEN, LOW);
  } else if (lockedAIState == "FIRE_RISK") {
    digitalWrite(BUZZER_PIN, HIGH); 
    digitalWrite(RGB_RED, HIGH); digitalWrite(RGB_GREEN, LOW); digitalWrite(RGB_BLUE, LOW);
  } else if (lockedAIState == "POLLUTION") {
    digitalWrite(BUZZER_PIN, HIGH); 
    digitalWrite(RGB_RED, HIGH); digitalWrite(RGB_BLUE, HIGH); digitalWrite(RGB_GREEN, LOW); // Purple light
  }

  // 5. OLED SCREEN UPDATE
  display.clearDisplay();
  display.setCursor(0, 0);
  display.print("IP:"); display.println(WiFi.localIP()); 
  
  String shortState = lockedAIState;
  if(shortState == "LANDSLIDE_RISK") shortState = "L-SLIDE";
  else if(shortState == "FLOOD_RISK") shortState = "FLOOD";
  else if(shortState == "FIRE_RISK") shortState = "FIRE";
  else if(shortState == "POLLUTION") shortState = "SMOKE";
  
  display.print("AI:"); display.print(shortState.substring(0,7)); display.print(" Rsk:"); display.print(overallRisk); display.println("%");
  display.print("T:"); display.print(features[0], 0); display.print("C H:"); display.print(features[1], 0); display.print("% G:"); display.println(features[3], 0);
  display.print("Wtr:"); display.print(features[2], 0); display.print("cm ");
  display.print("Vib:"); display.print(features[6], 1); display.println("g");
  display.display();

  // ==========================================
  // DIRECT SMS TRIGGER (BYPASSES THE WEBSITE)
  // ==========================================
  if (lockedAIState != "NORMAL" && lockedAIState != lastSmsState && WiFi.status() == WL_CONNECTED) {
      HTTPClient httpSMS;
      String threatStr = "HAZARD";
      if (lockedAIState == "FIRE_RISK") threatStr = "FOREST%20FIRE";
      else if (lockedAIState == "FLOOD_RISK") threatStr = "FLASH%20FLOOD";
      else if (lockedAIState == "LANDSLIDE_RISK") threatStr = "LANDSLIDE";
      else if (lockedAIState == "POLLUTION") threatStr = "SEVERE%20POLLUTION";
      
      String url = "https://trigger.macrodroid.com/0e56f7cc-ce01-43fc-bff7-e9b751ea4195/rakshak?threat=" + threatStr;
      httpSMS.begin(url);
      int smsCode = httpSMS.GET(); // Tells MacroDroid to send the text
      Serial.print("MacroDroid SMS Trigger Code: ");
      Serial.println(smsCode);
      httpSMS.end();
      
      lastSmsState = lockedAIState; // Lock it so it only sends 1 text per disaster
  } else if (lockedAIState == "NORMAL") {
      lastSmsState = "NORMAL"; // Reset when system is safe
  }

  // 6. CLOUD SYNC (Sped up to 1000ms for instant SIH presentation response!)
  if (WiFi.status() == WL_CONNECTED && (millis() - lastCloudSync > 1000)) {
    HTTPClient http;
    http.begin(supabaseURL);
    http.addHeader("apikey", supabaseKey);
    http.addHeader("Authorization", "Bearer " + supabaseKey);
    http.addHeader("Content-Type", "application/json");
    http.addHeader("Prefer", "return=minimal");
    
    StaticJsonDocument<200> doc;
    doc["status"] = lockedAIState; 
    doc["temperature"] = features[0];
    doc["humidity"] = features[1];
    doc["water_clearance"] = features[2];
    doc["gas"] = features[3];
    doc["vibration"] = features[6];
    
    String payload;
    serializeJson(doc, payload);
    
    // CAPTURE AND PRINT THE ERROR CODE
    int httpResponseCode = http.POST(payload); 
    Serial.print("Cloud Upload Status Code: ");
    Serial.println(httpResponseCode);
    
    http.end();
    lastCloudSync = millis();
  }
}
